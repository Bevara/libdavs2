{
    "name": "libdavs2",
    "version": "1.0.1",
    "description": "AVS2 (AVS2-P2) video decoder",
    "filters":["avs2dec"],
    "help": "This filter decodes raw AVS2 elementary streams using davs2.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/libdavs2.accessor",
    "filter_source":{
        "avs2dec" : "dec_avs2.c"
    },
    "extension":{
      "avs2" : "video"
    },
    "using": ["mm_solver_1.0.1", "mm_solver_1.0.2", "mm_solver_1.0.3", "mm_solver_1.0.4"],
    "patents": {
        "status": "licence-required",
        "note": "AVS2: AVS patent pool",
        "checked": "2026-10-16"
    }
}
